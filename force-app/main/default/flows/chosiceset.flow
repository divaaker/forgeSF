                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>$User.Id</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>test</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
