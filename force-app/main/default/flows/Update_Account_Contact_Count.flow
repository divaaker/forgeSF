    <decisions>
        <name>Check_AccountId_Changed</name>
        <label>Check AccountId Changed</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Reset_Count_For_New</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>AccountId Changed or Delete</defaultConnectorLabel>
        <rules>
            <name>No_Change_Create_or_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.AccountId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.AccountId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reset_Count_For_New</targetReference>
            </connector>
            <label>No Change - Create or Update</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Old_Account_Exists</name>
        <label>Check If Old Account Exists</label>
        <locationX>176</locationX>
        <locationY>755</locationY>
        <defaultConnector>
            <targetReference>Add_New_Account_To_Collection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Old Account</defaultConnectorLabel>
        <rules>
            <name>Old_Account_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HasOldAccount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.AccountId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.AccountId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reset_Count_For_Old</targetReference>
            </connector>
            <label>Old Account Exists</label>
        </rules>
    </decisions>
    <description>Automatically updates the No_of_Contacts__c field on Account when Contacts are created, updated, or deleted</description>
    <environments>Default</environments>
    <formulas>
        <name>HasOldAccount</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!$Record__Prior.AccountId}))</expression>
    </formulas>
    <interviewLabel>Update Account Contact Count {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Account Contact Count</label>
