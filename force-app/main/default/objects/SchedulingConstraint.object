    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableFeeds>false</enableFeeds>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>BreakEarliestStartTime</fullName>
    </fields>
    <fields>
        <fullName>BreakLatestStartTime</fullName>
    </fields>
    <fields>
        <fullName>CalculationMode</fullName>
        <inlineHelpText>Calculates the total number of service appointments or the sum of numeric fields included in the pay period.</inlineHelpText>
    </fields>
    <fields>
        <fullName>Id</fullName>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>IsAllTravelIncluded</fullName>
        <inlineHelpText>Determines whether to include travel between appointments and travel to and from home. Relevant only if the Calculation Mode is Sum.</inlineHelpText>
    </fields>
    <fields>
        <fullName>IsLunchBreaksIncluded</fullName>
        <inlineHelpText>Determines whether to include scheduled lunch breaks. Relevant only if the Calculation Mode is Sum.</inlineHelpText>
    </fields>
    <fields>
        <fullName>IsResourceAbsencesIncluded</fullName>
        <inlineHelpText>Determines whether to include resource absences in the sum. Relevant only if the Calculation Mode is Sum.</inlineHelpText>
    </fields>
    <fields>
        <fullName>IsTravelFromHomeExcluded</fullName>
        <inlineHelpText>Determines whether to include the first travel of the day from home base in the sum. Relevant only if the Calculation Mode is Sum.</inlineHelpText>
    </fields>
    <fields>
        <fullName>IsTravelToHomeExcluded</fullName>
        <inlineHelpText>Determines whether to include the last travel of the day to home base in the sum. Relevant only if the Calculation Mode is Sum.</inlineHelpText>
    </fields>
    <fields>
        <fullName>MaxContractValueForPayPeriod</fullName>
        <inlineHelpText>The maximum amount of contracted work allowed for the resource per pay period before a rule violation is triggered.</inlineHelpText>
    </fields>
    <fields>
        <fullName>MaxNonstandardShiftsPerMonth</fullName>
    </fields>
    <fields>
        <fullName>MaxShiftsPerDay</fullName>
    </fields>
    <fields>
        <fullName>MaxShiftsPerMonth</fullName>
    </fields>
    <fields>
        <fullName>MaxShiftsPerWeek</fullName>
    </fields>
    <fields>
        <fullName>MaxWorkHrPerShftPerWk</fullName>
    </fields>
    <fields>
        <fullName>MaxWorkingHoursPerDay</fullName>
    </fields>
    <fields>
        <fullName>MaxWorkingHoursPerMonth</fullName>
    </fields>
    <fields>
        <fullName>MaxWorkingHoursPerWeek</fullName>
    </fields>
    <fields>
        <fullName>MinContractValueForPayPeriod</fullName>
        <inlineHelpText>The minimum amount of contracted work for the resource per pay period.</inlineHelpText>
    </fields>
    <fields>
        <fullName>Name</fullName>
    </fields>
    <fields>
        <fullName>OwnerId</fullName>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ResourceAbsenceFieldToSum</fullName>
        <inlineHelpText>Determines which field on the Resource Absence to include in the calculation of the pay period. Relevant only if the Calculation Mode is Sum.</inlineHelpText>
    </fields>
    <fields>
        <fullName>RestTimeMinutes</fullName>
    </fields>
    <fields>
        <fullName>SvcAppointmentFieldToSum</fullName>
        <inlineHelpText>Determines which numeric field on the Service Appointment to include in the sum, for example, the duration. Relevant only if the Calculation Mode is Sum.</inlineHelpText>
    </fields>
    <listViews>
        <fullName>All_SchedulingConstraints</fullName>
        <filterScope>Everything</filterScope>
        <label>All Scheduling Constraints</label>
    </listViews>
    <listViews>
        <fullName>My_SchedulingConstraints</fullName>
        <filterScope>Mine</filterScope>
        <label>My Scheduling Constraints</label>
    </listViews>
    <sharingModel>Private</sharingModel>
</CustomObject>
