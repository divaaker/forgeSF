<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <listViews>
        <fullName>All_Books</fullName>
        <filterScope>Everything</filterScope>
        <label>All Books</label>
    </listViews>
    <validationRules>
        <fullName>Rating_Required_When_Completed</fullName>
        <active>true</active>
        <description>A Rating must be supplied once a Book is marked Completed.</description>
        <errorConditionFormula>AND( ISPICKVAL(Status__c, &quot;Completed&quot;), ISBLANK(Rating__c) )</errorConditionFormula>
        <errorDisplayField>Rating__c</errorDisplayField>
        <errorMessage>Please provide a Rating when marking a book as Completed.</errorMessage>
    </validationRules>
</CustomObject>
